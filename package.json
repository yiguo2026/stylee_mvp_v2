{
  "name": "stylee-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "build:web": "node node_modules/expo/bin/cli export --platform web && node ./scripts/patch-html.js",
    "tokens:build": "node ./scripts/generate-design-tokens.mjs",
    "tokens:check": "node ./scripts/generate-design-tokens.mjs --check",
    "outfit-metrics:build": "python3 scripts/check-outfit-fixture-alpha.py --write",
    "outfit-metrics:check": "python3 scripts/check-outfit-fixture-alpha.py --check",
    "wardrobe-density:check": "node ./scripts/check-wardrobe-density.mjs",
    "design-system:check": "node ./scripts/check-design-system.mjs",
    "test:vendor": "node --test scripts/stymobile-vendor-contract.test.mjs",
    "vendor:check": "node scripts/verify-stymobile-vendor.mjs",
    "test:account-scope": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test src/lib/accountScopeRuntime.test.ts src/lib/privateStateReset.test.ts src/lib/profileCache.test.ts src/lib/scopedStoreRead.test.ts src/lib/authSessionCoordinator.test.ts",
    "check": "npm run tokens:check && npm run design-system:check && npm run wardrobe-density:check && npm run test:account-scope && tsc --noEmit",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:ios": "npx expo prebuild --platform ios && node ./scripts/patch-privacy.js",
    "web": "expo start --web",
    "lint": "expo lint"
  },
  "dependencies": {
    "@stymobile/contracts": "file:vendor/stymobile/5b9b51adfb1dc9c10c61f13244087f6ecf54d34d/stymobile-contracts-0.1.0.tgz",
    "@stymobile/core": "file:vendor/stymobile/5b9b51adfb1dc9c10c61f13244087f6ecf54d34d/stymobile-core-0.1.0.tgz",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/elements": "^2.3.0",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.106.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-media-library": "~18.2.1",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "pg": "^8.21.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.8.0"
  },
  "engines": {
    "node": "22.x",
    "npm": "11.12.1"
  },
  "private": true
}
